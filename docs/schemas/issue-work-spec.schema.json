{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/unsafe-review-swarm/blob/main/docs/schemas/issue-work-spec.schema.json",
  "title": "Issue-linked work specification",
  "description": "A bounded implementation contract for one GitHub issue and its delivery PR. It is not a scheduler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "kind",
    "objective",
    "user_outcome",
    "claim_boundary",
    "scope",
    "invariant",
    "acceptance",
    "integration",
    "risk",
    "rollback"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "issue": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[1-9][0-9]*$"
    },
    "kind": {
      "enum": ["correctness", "ux", "interop", "robustness", "maintenance", "research"]
    },
    "objective": { "type": "string", "minLength": 1 },
    "user_outcome": { "type": "string", "minLength": 1 },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/scope" },
    "invariant": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptance" }
    },
    "integration": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/integration" }
    },
    "risk": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/risk" }
    },
    "rollback": { "$ref": "#/$defs/rollback" },
    "dependencies": { "$ref": "#/$defs/string_array" },
    "blockers": { "$ref": "#/$defs/string_array" },
    "affected_files": { "$ref": "#/$defs/string_array" },
    "affected_symbols": { "$ref": "#/$defs/string_array" },
    "linked_specs": { "$ref": "#/$defs/string_array" },
    "linked_adrs": { "$ref": "#/$defs/string_array" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "delivery": { "$ref": "#/$defs/delivery" }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": { "$ref": "#/$defs/string_array" },
        "excluded": { "$ref": "#/$defs/string_array" }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^INV-[A-Za-z0-9._-]+$" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "proof"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[A-Za-z0-9._-]+$" },
        "text": { "type": "string", "minLength": 1 },
        "proof": { "$ref": "#/$defs/string_array" }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "expected"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mitigation"],
      "properties": {
        "id": { "type": "string", "pattern": "^RISK-[A-Za-z0-9._-]+$" },
        "mitigation": { "type": "string", "minLength": 1 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture"],
      "properties": {
        "posture": { "type": "string", "minLength": 1 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pr": { "type": "string", "format": "uri" },
        "closeout": { "type": "string", "format": "uri" }
      }
    }
  }
}
