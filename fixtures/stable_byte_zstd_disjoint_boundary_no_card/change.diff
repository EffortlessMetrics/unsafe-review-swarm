diff --git a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -1,0 +1,34 @@
+pub struct JsBuffer;
+pub struct ZstdContext;
+
+impl JsBuffer {
+    pub fn byte_slice(&self) -> &[u8] {
+        &[]
+    }
+
+    pub fn byte_slice_mut(&mut self) -> &mut [u8] {
+        &mut []
+    }
+}
+
+impl ZstdContext {
+    pub fn set_buffers(&mut self, _input: Option<&[u8]>, _output: Option<&mut [u8]>) {}
+
+    pub fn compress(&mut self) -> Result<usize, ()> {
+        Ok(0)
+    }
+}
+
+pub fn zstd_overlap_native_ffi_guarded(
+    input: &JsBuffer,
+    output: &mut JsBuffer,
+    ctx: &mut ZstdContext,
+) -> Result<usize, ()> {
+    let input_bytes = input.byte_slice();
+    let output_bytes = output.byte_slice_mut();
+    reject_overlap(input_bytes, output_bytes)?;
+    ctx.set_buffers(Some(input_bytes), Some(output_bytes));
+    ctx.compress()
+}
+
+fn reject_overlap(_input: &[u8], _output: &[u8]) -> Result<(), ()> {
+    Ok(())
+}
